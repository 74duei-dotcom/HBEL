{
  "name": "english-library",
  "version": "0.1.0",
  "private": true,
  "description": "영어 서재 - 내 논문·영상으로 공부하는 개인용 영어 학습 앱 (PWA)",
  "scripts": {
    "postinstall": "node scripts/copy-pdf-worker.mjs && node scripts/copy-ocr-files.mjs",
