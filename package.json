    "idb-keyval": "^6.2.1",
    "kokoro-js": "^1.2.1",
    "next": "^16.0.0",
    "pdfjs-dist": "^5.4.0",
    "phonemizer": "^1.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0",
    "ts-fsrs": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
