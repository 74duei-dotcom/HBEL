# 이 파일을 복사해서 이름을 .env.local 로 바꾼 뒤, 구글 클라우드에서 받은 값을 넣으세요.
# .env.local 은 .gitignore 에 들어 있어 GitHub에 올라가지 않습니다.

# 6단계에서 만든 OAuth 클라이언트 ID (…apps.googleusercontent.com 으로 끝남)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 7단계에서 만든 API 키 (AIza… 로 시작, Google Picker API 전용으로 제한한 키)
NEXT_PUBLIC_GOOGLE_API_KEY=

# 8단계에서 확인한 프로젝트 번호 (숫자만)
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=

# 단어 뜻·한글 발음·번역에 쓸 Claude 모델 (기본값: 가장 빠르고 저렴한 모델)
NEXT_PUBLIC_CLAUDE_MODEL=claude-haiku-5-5

# Gemini를 고른 경우 쓸 모델 (기본값: gemini-3.5-flash-lite = 무료 하루 500회). gemini-3.8-flash 는 무료가 하루 20회뿐이라 비추천. Gemini 키는 앱 설정 화면에서 입력합니다.
NEXT_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite

# PC에서 개발할 때는 비워 두세요. (GitHub Pages 배포 때는 자동으로 /저장소이름 이 들어갑니다)
NEXT_PUBLIC_BASE_PATH=
